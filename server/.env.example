# Cổng API
PORT=4000
# Khóa ký JWT - đổi thành chuỗi ngẫu nhiên dài khi dùng thật
JWT_SECRET=doi-chuoi-nay-truoc-khi-dung-that

# CSDL: mssql (SQL Server, mặc định) hoặc sqlite (chỉ để chạy thử/test)
DB_CLIENT=mssql
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=MatKhauCuaBan
DB_NAME=IS028
# Nếu dùng SQL Server Express có tên instance (vd SQLEXPRESS) thì điền, khi đó bỏ trống DB_PORT
